# Còpia a `.env` per al desenvolupament local. Les variables PUBLIC_* són públiques (arriben al client).

# Beta privada: `true` (per defecte, també si falta) = tot el lloc noindex, nofollow i sitemaps buits.
# Es llegeix al build. El dia del llançament: `false` (vegeu docs/02-arquitectura-seo.md §7.1).
PUBLIC_MODE_BETA=true

# Supabase (comptes i sync, fase 5). Públiques per disseny: URL del projecte i clau
# **publicable** (`sb_publishable_…`), que només dona el que permet la RLS. Si falten aquí, el
# build les agafa de `vars` de `wrangler.jsonc`. MAI la `service_role` ni la contrasenya de la BD.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
